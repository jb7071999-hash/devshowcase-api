# Copie este arquivo para ".env" e preencha com as credenciais reais.
# NUNCA suba o .env real para o GitHub (ele já está no .gitignore).

PORT=3000
NODE_ENV=development

# Credenciais do banco na nuvem (ex.: Supabase ou Render PostgreSQL)
DB_HOST=seu-host.supabase.co
DB_PORT=5432
DB_NAME=devshowcase
DB_USER=postgres
DB_PASSWORD=sua-senha
DB_SSL=true

# URL pública da API em produção (usada só como referência no README)
PUBLIC_API_URL=https://devshowcase-api.onrender.com
